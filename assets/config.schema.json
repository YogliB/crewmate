{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://raw.githubusercontent.com/YogliB/crewmate/main/assets/config.schema.json",
	"$comment": "Unknown keys are ignored by the runtime; additionalProperties is true for forward compatibility.",
	"type": "object",
	"properties": {
		"provider": {
			"type": "string"
		},
		"model": {
			"type": "string"
		},
		"interval": {
			"type": "integer",
			"minimum": 1
		},
		"user": {
			"type": "string"
		},
		"prompt": {
			"type": "string"
		},
		"log": {
			"type": "boolean"
		},
		"debug": {
			"type": "boolean"
		},
		"unsafeNoUser": {
			"type": "boolean"
		},
		"timeoutSeconds": {
			"type": "integer",
			"minimum": 1
		}
	},
	"additionalProperties": true
}
