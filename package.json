{
	"name": "crewmate",
	"version": "0.0.1",
	"description": "A CLI that watches GitHub PR comments for @crewmate mentions and replies with explanations or generated fixes.",
	"keywords": [
		"cli"
	],
	"homepage": "https://github.com/YogliB/crewmate#readme",
	"bugs": {
		"url": "https://github.com/YogliB/crewmate/issues"
	},
	"license": "MIT",
	"author": "YogliB <me@yogev.dev>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YogliB/crewmate.git"
	},
	"bin": {
		"crewmate": "dist/bin.js"
	},
	"files": [
		"assets",
		"dist",
		"LICENSE.md",
		"README.md"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"dev": "tsdown --config tsdown.config.ts --watch",
		"build": "tsdown --config tsdown.config.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --fix src",
		"lint:ci": "oxlint src",
		"format": "oxfmt --write .",
		"format:ci": "oxfmt --check .",
		"duplicates:ci": "jscpd --gitignore --reporters console --threshold 5 tsdown.config.ts vitest.config.ts src",
		"knip:ci": "knip",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ci": "vitest run --coverage",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/node": "24",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint-plugin-security": "4.0.1",
		"husky": "9.1.7",
		"jscpd": "4.0.9",
		"knip": "6.11.0",
		"lint-staged": "17.1.1",
		"oxfmt": "0.61.0",
		"oxlint": "1.76.0",
		"tsdown": "0.22.14",
		"typescript": "7.0.2",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"**/*": "oxfmt --write --no-error-on-unmatched-pattern",
		"**/*.ts": "oxlint --fix"
	},
	"devEngines": {
		"packageManager": {
			"name": "nub",
			"version": "^0.6.0",
			"onFail": "warn"
		}
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
